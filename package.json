{
  "name": "speed-editor",
  "version": "2.0.0",
  "private": true,
  "description": "基于 Ant Design Vue + Tiptap 的富文本编辑器（Monorepo）",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "node scripts/build-lib.mjs",
    "dev": "turbo run dev --parallel",
    "demo": "pnpm --filter @speed-editor/vue3-demo dev --host 0.0.0.0",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "clean:node_modules": "find . -name node_modules -type d -prune -exec rm -rf {} +",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:deploy": "pnpm docs:build && pnpm --filter @speed-editor/vue3-demo build && node scripts/prepare-deploy.js",
    "changeset:check": "bash ./changed-packages-since-release.sh",
    "changeset": "bash ./changed-packages-since-release.sh && changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "srd:check": "bash ./scripts/check-local-changes.sh",
    "srd:changeset": "bash ./scripts/check-local-changes.sh && changeset",
    "srd:release": "pnpm version-packages && pnpm build && changeset publish",
    "test": "vitest",
    "lint": "eslint packages demos --ext .ts,.tsx,.vue",
    "format": "prettier --write \"packages/**/*.{ts,tsx,vue}\" \"demos/**/*.{ts,tsx,vue}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "editor",
    "rich-text-editor",
    "speed-editor",
    "ant-design-vue"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whateveryoudo/speed-editor.git"
  },
  "bugs": {
    "url": "https://github.com/whateveryoudo/speed-editor/issues"
  },
  "homepage": "https://github.com/whateveryoudo/speed-editor#readme",
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@changesets/cli": "^2.31.0",
    "@highlightjs/vue-plugin": "^2.1.2",
    "@types/node": "^20.11.0",
    "@unocss/vite": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "ant-design-vue": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-vue": "^9.21.0",
    "fs-extra": "^11.3.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.0.0",
    "less": "^4.2.0",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "unocss": "^0.58.0",
    "unplugin-vue-components": "^28.7.0",
    "vitepress": "^1.0.0",
    "vitest": "^1.2.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
