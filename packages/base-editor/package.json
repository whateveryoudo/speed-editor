    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vueuse/core": "^13.1.0",
    "ant-design-vue": "^4.1.0",
    "less": "^4.2.0",
    "lodash-es": "^4.17.21",
    "typescript": "^5.6.0",
    "unocss": "^0.58.0",
    "unplugin-dts": "1.0.0-beta.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^5.0.0",
    "vite-plugin-node-stdlib-browser": "^0.2.1",
    "vue": "^3.5.0",
