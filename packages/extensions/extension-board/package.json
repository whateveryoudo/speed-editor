{
  "name": "@speed-editor/extension-board",
  "version": "2.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "dist/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp src/shim.d.ts dist/index.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-board/core": "link:../../../../speed-board/packages/core",
    "@speed-board/vue3-antd": "link:../../../../speed-board/packages/vue3-antd",
    "@speed-editor/composables": "workspace:^",
    "@speed-editor/schema": "workspace:^",
    "@speed-editor/shared": "workspace:^",
    "@tiptap/core": "3.13.0",
    "@tiptap/pm": "3.13.0",
    "@tiptap/vue-3": "3.6.6"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "ant-design-vue": "^4.2.0",
    "less": "^4.2.0",
    "typescript": "^5.6.0",
    "unocss": "^0.62.0",
    "vite": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
