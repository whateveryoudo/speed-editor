{
  "name": "@speed-editor/document-io",
  "version": "2.0.1",
  "description": "前端导入包（已废弃，会切换到后端进行实现，减少前端包大小）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tiptap/core": "3.13.0",
    "highlight.js": "^11.11.1",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.1"
  },
  "devDependencies": {
    "@tiptap/core": "3.13.0",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
