{
  "name": "@speed-editor/lite-editor",
  "version": "2.0.6",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin-entry.d.ts",
      "import": "./dist/plugin.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "dist/*.css"
  ],
  "scripts": {
    "build": "vite build && cp src/plugin-entry.d.ts dist/plugin-entry.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-editor/base-editor": "workspace:^",
    "@speed-editor/extension-kit": "workspace:^",
    "@speed-editor/kit-base": "workspace:^",
    "@speed-editor/shared": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "ant-design-vue": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
