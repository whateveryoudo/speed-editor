{
  "name": "@speed-editor/kit-base",
  "version": "2.0.9",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less",
    "dist/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp src/shim.d.ts dist/index.d.ts",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@speed-editor/composables": "workspace:^",
    "@speed-editor/schema": "workspace:^",
    "@speed-editor/shared": "workspace:^",
    "@tiptap/core": "3.13.0",
    "@tiptap/pm": "3.13.0",
    "@tiptap/vue-3": "3.6.6",
    "@tiptap/extension-emoji": "3.13.0",
    "@tiptap/extension-node-range": "3.27.3",
    "@tiptap/extension-subscript": "3.13.0",
    "@tiptap/extension-superscript": "3.13.0",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.0",
    "speed-components-ui": "^1.1.5"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "ant-design-vue": "^4.0.0",
    "@ant-design/icons-vue": "^7.0.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@tiptap/core": "3.13.0",
    "@tiptap/pm": "3.13.0",
    "@tiptap/vue-3": "3.6.6",
    "@unocss/vite": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@types/markdown-it": "^14.1.2",
    "ant-design-vue": "^4.1.0",
    "typescript": "^5.6.0",
    "unocss": "^0.58.0",
    "vite": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
